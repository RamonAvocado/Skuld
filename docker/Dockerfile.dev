FROM node:22-slim
COPY --from=oven/bun:1.4.2 /usr/local/bin/bun /usr/local/bin/bun
# uv runs Python suites (`uv run pytest`) and fetches the Python version each project pins
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
# Same runtime deps as the prod image: git for coverage snapshots, Chromium for sitespeed.io
RUN apt-get update && apt-get install -y --no-install-recommends git chromium chromium-driver fonts-liberation \
  && rm -rf /var/lib/apt/lists/*
